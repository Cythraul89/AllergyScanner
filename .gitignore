# Generated platform folders — never committed. CI scaffolds each one with
# `flutter create --platforms=<p> .`; native changes are patch steps in
# .github/workflows/build.yml.
src/android/
src/ios/
# Unsupported platforms — ignored so an accidental `flutter create` cannot commit them.
src/macos/
src/linux/
src/windows/
src/web/

# Generated code (Drift) — regenerated by every CI job.
*.g.dart
*.freezed.dart

# Dart / Flutter
.dart_tool/
.packages
.pub-cache/
.pub/
build/
src/build/
*.lock.orig
src/.flutter-plugins
src/.flutter-plugins-dependencies
src/.metadata

# pubspec.lock is committed for an application (it pins the dependency set).
!src/pubspec.lock

# Local Flutter/Dart tooling
.flutter-versions
doc/api/

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# Transfer bundle: personal Claude Code config and a full chat transcript.
# Useful to carry between machines, not something to commit.
/migration/

# Project-local Claude Code session state (e.g. scheduled-task locks).
/.claude/

# Local secrets and signing material — must never be committed.
*.jks
*.keystore
*.p12
*.mobileprovision
key.properties
.env
.env.*

# Test / coverage output
coverage/
src/coverage/
test/.test_coverage.dart
